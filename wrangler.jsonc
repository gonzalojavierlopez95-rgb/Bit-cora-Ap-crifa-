{
  "name": "bit-cora-ap-crifa",
  "main": "worker.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "run_worker_first": ["/api/*"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitacora_notas",
      "database_id": "bb1ef1fb-f670-4e43-bc36-dd1215a079d3"
    }
  ]
}
